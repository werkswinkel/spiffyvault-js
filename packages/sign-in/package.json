{
  "name": "@spiffyvault/sign-in",
  "version": "0.1.0",
  "description": "Sign in with SpiffyVault (OIAP-v2): make and check sign-in challenges on your site, and show them in the browser as a QR code and a typed code, or as a link on the phone.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && npm run build && tsc -p tsconfig.test.json",
    "test": "npm run test:unit",
    "test:unit": "npm run build && node --test 'test/unit/**/*.test.ts'",
    "test:integration": "npm run build && node --test --test-concurrency=1 --test-timeout=120000 'test/integration/**/*.test.ts'",
    "test:all": "npm run test:unit && npm run test:integration",
    "example": "npm run build && node examples/site.ts"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/werkswinkel/spiffyvault-js.git",
    "directory": "packages/sign-in"
  }
}
